# Dictionary for open5gs nas_message_fuzz (ogs_nas_emm_decode).
# Tokens are the first bytes that steer the EPS NAS / EMM message decoder:
# byte0 = security-header-type (high nibble) | protocol-discriminator (low nibble; 0x7 = EPS MM),
# byte1 = EMM/ESM message type. Feeding valid (hdr,type) prefixes pushes the fuzzer past the
# length guard into the per-message IE parsers.

# --- protocol discriminator / security header byte0 ---
"\x07"
"\x17"
"\x27"
"\x37"
"\xc7"
"\x02"

# --- EMM message types (byte1) ---
"\x41"
"\x42"
"\x43"
"\x44"
"\x45"
"\x46"
"\x48"
"\x49"
"\x4b"
"\x4c"
"\x4d"
"\x4e"
"\x50"
"\x52"
"\x53"
"\x54"
"\x5c"
"\x55"
"\x56"
"\x5d"
"\x5e"
"\x5f"
"\x60"
"\x61"
"\x62"
"\x63"

# --- ESM message types ---
"\xc1"
"\xc5"
"\xc9"
"\xcd"
"\xd0"
"\xd4"

# --- common IE / APN bytes ---
"internet"
"\x09\x09\x08"
"\x27"
"\x5d"
"\x78"
