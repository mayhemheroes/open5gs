# Dictionary for open5gs gtp_message_fuzz (ogs_gtp2_parse_msg).
# GTPv2-C header: byte0 = version(3 bits)|P|T|spare; byte1 = message type; bytes2-3 = length.
# 0x48 = version 2, TEID present; 0x40 = version 2, no TEID. After the header come TLV IEs
# (IE type, 2-byte length, instance, value) — the tokens below seed both the header and the IEs.

# --- header byte0 variants ---
"\x40"
"\x48"

# --- GTPv2-C message types (byte1) ---
"\x01"
"\x02"
"\x03"
"\x20"
"\x21"
"\x22"
"\x23"
"\x24"
"\x25"
"\x5f"
"\x60"
"\x63"
"\x65"
"\x80"
"\x82"

# --- common GTPv2 IE type bytes ---
"\x01"
"\x03"
"\x47"
"\x48"
"\x49"
"\x4b"
"\x4c"
"\x4e"
"\x4f"
"\x53"
"\x56"
"\x57"
"\x5d"
"\x5f"
"\x72"
"\x7f"

# --- common IE value fragments ---
"internet"
"\x00\x06\x00"
